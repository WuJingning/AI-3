# 统一换行符，避免 Windows 与 Linux（CI / 容器）之间产生无意义的整文件 diff
* text=auto

*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.example text eol=lf
*.sh text eol=lf

# 容器与反向代理配置文件必须保持 LF，否则多行指令可能被 CRLF 破坏
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Caddyfile text eol=lf
*.service text eol=lf

# Windows 批处理需要 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
