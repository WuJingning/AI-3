# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会进入代码仓库。
# 也可以直接使用系统环境变量：环境变量优先级高于本文件。

# 扣子个人访问密钥（仅服务端使用，请勿写入前端代码或文档）
COZE_API_TOKEN=

# 扣子工作流 ID
COZE_WORKFLOW_ID=

# 扣子开放平台接口地址（国内站固定为 https://api.coze.cn）
COZE_API_BASE=https://api.coze.cn

# 本地网页服务端口
PORT=8787

# 对外监听地址：0.0.0.0 表示允许其他机器访问；127.0.0.1 表示仅本机可访问
HOST=0.0.0.0

# 是否允许在“扣子文件直传”不可用时，通过一次性临时链接把合同内容提交给工作流。
# 关闭后，文件直传权限缺失时会直接提示错误，不再使用第三方临时链接。
ALLOW_TEMP_LINK=true

# 单次工作流调用超时时间（毫秒）
COZE_TIMEOUT_MS=180000
